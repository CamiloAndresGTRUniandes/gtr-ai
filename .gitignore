# GTR-AI repository ignore rules.
# Evidence is committed only under approved evidence directories
# (evidence/, verification/evidence/, archive/, docs/benchmarks/raw-results/,
# spikes/unblock/). Dependency manifests and lockfiles stay tracked.

# Dependencies
node_modules/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
bower_components/

# Experimental workspaces (local, disposable; evidence is copied out after review)
.spike-workspaces/
.spike-workspace*/
spike-workspaces/
.sandbox/
tmp/
.tmp/

# Build outputs
dist/
build/
out/
coverage/
.nyc_output/
*.tsbuildinfo
*.node
*.exe
*.dll
*.so
*.dylib
prebuilds/

# Caches
.cache/
.npm/
.eslintcache
.turbo/
.parcel-cache/
.vite/
__pycache__/
*.pyc

# Credentials and secrets
.env
.env.*
!.env.example
.npmrc
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials*.json
auth.json
secrets.*

# Local databases
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Logs (allowed only inside approved evidence directories)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
!evidence/**/*.log
!verification/evidence/**/*.log
!spikes/unblock/**/*.log

# Downloaded models
models/
*.gguf
*.ggml
*.safetensors
*.onnx
*.bin
*.pt
*.ckpt

# Editor and OS noise
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
